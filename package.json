{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server-node.ts",
    "dev:postgres": "powershell -ExecutionPolicy Bypass -File scripts/start-postgres-dev.ps1",
    "start": "node dist-server/server-node.js",
    "start:prod": "npm run build && npm run start",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "build": "node scripts/build-schema.mjs && node scripts/prepare-seed.mjs && vite build --ssr src/server-node.ts --outDir dist-server",
    "preview": "npm run start",
    "prebuild": "node scripts/build-schema.mjs && node scripts/prepare-seed.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "htm": "^3.1.1",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "preact": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "vite": "^8.1.4"
  }
}

